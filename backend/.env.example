# Copy this file to .env and fill in your values
FLASK_ENV=development

# Generate a strong random string for each:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret
JWT_SECRET_KEY=change-this-to-a-different-random-secret

# Database (leave as-is for SQLite dev, or use PostgreSQL for production)
# DEV_DATABASE_URL=sqlite:///development.db
# DEV_DATABASE_URL=postgresql://user:password@localhost:5432/classroom_scheduler

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
